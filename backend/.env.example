# Copy this file to .env and fill in the values below

# MongoDB Atlas connection string (get free at https://cloud.mongodb.com)
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/grocify?retryWrites=true&w=majority

# JWT secret key (use any long random string)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Your deployed frontend URL (set after deploying frontend)
FRONTEND_URL=https://your-app.vercel.app

# Port (Render sets this automatically)
PORT=5000
