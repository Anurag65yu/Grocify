# Grocify Frontend — Environment Variables
#
# LOCAL DEVELOPMENT (with backend running on port 5000):
#   VITE_API_URL=http://localhost:5000
#
# PRODUCTION (after deploying backend to Render):
#   VITE_API_URL=https://your-backend-name.onrender.com
#
# Leave empty (or don't create .env) to run in localStorage-only mode (no backend needed)
VITE_API_URL=
